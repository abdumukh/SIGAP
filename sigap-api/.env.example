APP_NAME="SIGAP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -------------------------------------------------------------------------
# DATABASE — Supabase PostgreSQL Session Pooler
# -------------------------------------------------------------------------
# Deploy ke Render:
#   ENV Vars → tambahkan semua baris di bawah via Render Dashboard
#   (JANGAN isi di .env, .env hanya untuk lokal development)
# -------------------------------------------------------------------------
# Render Dashboard → Service → Environment → Add Variable
DB_CONNECTION=pgsql
# DB_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# (opsional) DB_SSLCERT / DB_SSLKEY / DB_SSLROOTCERT — TIDAK dipakai untuk Session Pooler

# Session & Queue — pakai database (Supabase) agar persist
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Queue & Cache — database (tidak butuh Redis real-time di free tier)
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail (log hanya, tidak kirim email)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@sigap.id"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum — adjust domain untuk Render subdomain
# Contoh: https://sigap-api.onrender.com dan localhost dev
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,sigap-api.onrender.com

# API & CORS
# Render akan assign https://sigap-api.onrender.com
# Buka hanya origin yang diperlukan
CORS_ALLOWED_ORIGINS=https://sigap-api.onrender.com,http://localhost,http://127.0.0.1

# Rate Limiting
API_RATE_LIMIT=120
AUTH_RATE_LIMIT=10

# FCM (Firebase Cloud Messaging)
# Isi nilai ini saat siap deploy Firebase production
# Jika belum, biarkan kosong dan FCM akan disable (info log saja)
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=
FCM_SERVER_KEY=

# Flask not needed — Laravel Sanctum + Laravel Sanctum

# -------------------------------------------------
# Render-specific notes (bukan di-commit ke repo)
# -------------------------------------------------
# Saat deploy ke Render:
# 1. Buka Dashboard → Service → Environment
# 2. Tambahkan semua variabel di atas (tanpa nilai jika belum punya)
# 2. Deploy → Service akan running di https://sigap-api.onrender.com
# 3. Health check: https://sigap-api.onrender.com/up
# 4. Jika session expiry terjadi, cek Supabase connection pooling